# Copy to .env for local development. Production values are materialized by
# deploy.sh from GitHub Actions secrets/vars — never hand-place a real .env on
# a server.

# --- Required ---

# Public origin. This is the WebAuthn Relying Party origin and the base for
# one-time invite URLs, so it must match how the browser actually reaches the
# app or passkey registration fails.
PUBLIC_BASE_URL=http://localhost:3000

# Signs session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=dev-only-change-me

# --- Branding (generic defaults; override per deployment) ---
APP_NAME=Time Tracker
APP_SHORT_NAME=Time
APP_THEME_COLOR=#1c7ed6

# --- Storage ---
DATABASE_PATH=./data/time-tracker.db

# Wall-clock zone for "what day did this work happen on". QuickBooks stores a
# bare date with no zone, so this decides how evening work is booked.
TZ=America/Los_Angeles

# Currency rates and costs are shown in (ISO 4217). Display only.
APP_CURRENCY=USD

# --- Accounting backend: none | qb-bridge | qb-webconnector ---
# `none` runs standalone: jobs are defined in this app and nothing is pushed
# anywhere. That is the default so a fresh clone works with no dependencies.
ACCOUNTING_BACKEND=none

# qb-bridge: use the IPv4 literal, NOT the hostname. The bridge rejects
# non-private source IPs with 403 before checking the key, and a hostname that
# resolves to public IPv6 makes that look like an auth failure.
#QB_BRIDGE_URL=http://10.0.0.1:8743
#QB_BRIDGE_API_KEY=

# qb-webconnector: shared secret the Web Connector authenticates with.
#QBWC_PASSWORD=

# --- Web Push (optional; unset disables notifications entirely) ---
# Generate a keypair with: bunx web-push generate-vapid-keys
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:you@example.com
