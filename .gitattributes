# Normalise text in the repository, and pin LF for anything that is executed by
# a Linux box: the image is built on Linux and sw.js is served to browsers from
# it. A CRLF working copy on Windows is fine, but nothing may be committed with
# CRLF.
* text=auto eol=lf

*.sh      text eol=lf
Dockerfile text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

*.png binary
*.ico binary
