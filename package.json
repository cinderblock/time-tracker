{
  "name": "time-tracker",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "bun --bun react-router dev",
    "build": "bun --bun react-router build && bun scripts/finalize-build.ts",
    "start": "bun server.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "bun test src/ app/",
    "test:e2e": "bun run build && playwright test",
    "admin-link": "bun src/cli/admin-link.ts"
  },
  "dependencies": {
    "@mantine/colors-generator": "^9.6.1",
    "@mantine/core": "^9.0.0",
    "@mantine/dates": "^9.0.0",
    "@mantine/hooks": "^9.0.0",
    "@mantine/notifications": "^9.0.0",
    "@react-router/express": "^8.4.0",
    "@react-router/node": "^8.0.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.0",
    "chroma-js": "^3.2.0",
    "compression": "^1.8.2",
    "dayjs": "^1.11.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "idb": "^8.0.0",
    "morgan": "^1.12.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.0.0",
    "@types/bun": "latest",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "postcss": "^8.4.0",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^7.0.0",
    "vite": "^8.0.0"
  }
}
